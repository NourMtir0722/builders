{
  // Deploys ./dist as a static site on Cloudflare Workers: `npm run deploy`.
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "builderland",
  "compatibility_date": "2026-09-14",
  "workers_dev": true,
  "assets": { "directory": "./dist", "not_found_handling": "404-page" },
  // Your own domain goes here (or delete `routes` to use the free *.workers.dev address).
  "routes": [{ "pattern": "builderland.noormtir.com", "custom_domain": true }]
}
